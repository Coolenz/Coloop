{
  "name": "coloop",
  "version": "0.14.0",
  "description": "Coloop · RK 智能设备桌面工作台",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Coloop",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "test:coordination": "npm run build && node tests/coordination-e2e.mjs",
    "test:hooks": "npm run build && node tests/hooks-e2e.mjs",
    "test:control": "npm run build && node tests/control-e2e.mjs",
    "test:control:native": "npm run build && node tests/native-control-e2e.mjs",
    "test:credentials": "npm run build && node tests/credential-vault-e2e.mjs",
    "test:desktop": "npm run build && node tests/desktop-e2e.mjs",
    "setup:electron": "node node_modules/electron/install.js",
    "setup:remote": "node scripts/setup-remote.mjs",
    "package:win": "npm run build && electron-builder --win portable --x64",
    "package:dir": "npm run build && electron-builder --dir",
    "postinstall": "node node_modules/electron/install.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:docling": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-docling.ps1",
    "setup:stagehand": "node scripts/setup-stagehand.mjs",
    "setup:node": "node scripts/setup-node.mjs",
    "setup:cua": "node scripts/setup-cua.mjs",
    "prepare:runtime": "npm run setup:node && npm run setup:cua && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-docling.ps1"
  },
  "dependencies": {
    "@agent-tars/core": "0.3.1",
    "@browserbasehq/stagehand": "4.4.0",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "lucide-react": "^0.468.0",
    "openai": "6.0.0",
    "playwright-core": "1.64.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.16.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.4",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "npmRebuild": false,
    "appId": "ai.coloop.desktop",
    "productName": "Coloop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/office-window.ps1",
        "to": "office-window.ps1"
      },
      {
        "from": "resources/document-runtime.ps1",
        "to": "document-runtime.ps1"
      },
      {
        "from": "resources/voice-runtime.ps1",
        "to": "voice-runtime.ps1"
      },
      {
        "from": "resources/pdf-runtime.ps1",
        "to": "pdf-runtime.ps1"
      },
      {
        "from": "resources/office-runtime.ps1",
        "to": "office-runtime.ps1"
      },
      {
        "from": "resources/rk-proactive-agent.py",
        "to": "rk-proactive-agent.py"
      },
      {
        "from": "resources/rk-execution-adapter.py",
        "to": "rk-execution-adapter.py"
      },
      {
        "from": "resources/rk-memory-worker.py",
        "to": "rk-memory-worker.py"
      },
      {
        "from": "resources/clipboard-lease.ps1",
        "to": "clipboard-lease.ps1"
      },
      {
        "from": "resources/rk-cloud-agent.py",
        "to": "rk-cloud-agent.py"
      },
      {
        "from": "resources/browser-observer.py",
        "to": "browser-observer.py"
      },
      {
        "from": "resources/browser-runtime.py",
        "to": "browser-runtime.py"
      },
      {
        "from": "resources/desktop-observer.py",
        "to": "desktop-observer.py"
      },
      {
        "from": "resources/desktop-runtime.py",
        "to": "desktop-runtime.py"
      },
      {
        "from": "resources/private-login-focus.ps1",
        "to": "private-login-focus.ps1"
      },
      {
        "from": "resources/rapidocr-worker.py",
        "to": "rapidocr-worker.py"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": ".cache/cloudflared/cloudflared.exe",
        "to": "runtime/cloudflared.exe"
      },
      {
        "from": "resources/remote/LICENSE-cloudflared.txt",
        "to": "runtime/LICENSE-cloudflared.txt"
      },
      {
        "from": "resources/harness",
        "to": "harness",
        "filter": [
          "coloop-plugin.mjs"
        ]
      },
      {
        "from": "resources/docling-worker.py",
        "to": "docling-worker.py"
      },
      {
        "from": ".cache/docling-portable",
        "to": "runtime/docling",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!runtime-probe.json"
        ]
      },
      {
        "from": ".cache/node-runtime",
        "to": "runtime/node"
      },
      {
        "from": ".cache/cua-driver",
        "to": "runtime/cua-driver"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": "portable",
      "artifactName": "Coloop-${version}-Windows-${arch}.${ext}",
      "signExecutable": false
    },
    "electronDist": "node_modules/electron/dist",
    "asar": false
  }
}
