[Unit]
Description=RK private credential vault (Unix socket only)
After=local-fs.target

[Service]
Type=simple
User=root
Group=cat
UMask=0077
RuntimeDirectory=rk-credential-vault
RuntimeDirectoryMode=0750
StateDirectory=rk-credential-vault
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -I /usr/local/lib/rk-credential-vault/credential_vault.py
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_OVERRIDE
ReadWritePaths=/var/lib/rk-credential-vault /run/rk-credential-vault
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
