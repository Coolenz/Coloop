{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "files.eol": "\n",
  "files.exclude": {"**/__pycache__": true},
  "search.exclude": {".venv": true, ".venv-rknn": true, "third_party": true, "wsl": true, "downloads": true, "flash": true, "deployment": true},
  "files.watcherExclude": {"**/wsl/**": true, "**/downloads/Ubuntu22.04/**": true, "**/.venv/**": true},
  "[python]": {"editor.tabSize": 4, "editor.insertSpaces": true}
}
