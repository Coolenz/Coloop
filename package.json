{
  "name": "coloop",
  "version": "0.2.0",
  "description": "Coloop · RK 智能设备桌面工作台",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Coloop",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "setup:electron": "node node_modules/electron/install.js",
    "package:win": "npm run build && electron-builder --win portable --x64",
    "package:dir": "npm run build && electron-builder --dir",
    "postinstall": "node node_modules/electron/install.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.4",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "npmRebuild": false,
    "appId": "ai.coloop.desktop",
    "productName": "Coloop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/rapidocr-worker.py",
        "to": "rapidocr-worker.py"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": "portable",
      "artifactName": "Coloop-${version}-Windows-${arch}.${ext}",
      "signExecutable": false
    },
    "electronDist": "node_modules/electron/dist"
  }
}
